# .env.example: the list of environment variable NAMES this app needs.
# Safe to commit because it has NO real values. Copy the names into
# `.env.local` (on your computer) and into the Vercel dashboard (for the live site).

# Connection string for the Neon Postgres database (from the Neon console "Connect" button).
DATABASE_URL=

# How chatty the logs are: debug, info, warn, or error.
# Use "debug" in .env.local (your computer) and "info" in the Vercel dashboard (the live site).
LOG_LEVEL=

# OpenAI API key, used to turn text into embeddings (search by meaning). Keep it secret.
OPENAI_API_KEY=

# A secret you make up (try `openssl rand -hex 24`). The /search page and its API need it
# until real login exists. Keep it secret.
ADMIN_API_KEY=

# Claude API key, used to write answers from the retrieved passages. Keep it secret.
ANTHROPIC_API_KEY=

# Optional. The Claude model that writes answers. Leave empty to use the default (claude-sonnet-5-5).
ANSWER_MODEL=

# Optional. Only needed if your Claude API key is not tied to one workspace (the API then
# answers status 400). The ID starts with wrkspc_ and is in the Claude Console under Workspaces.
ANTHROPIC_WORKSPACE_ID=
