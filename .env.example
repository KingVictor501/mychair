# .env.example: the list of environment variable NAMES this app needs.
# Safe to commit because it has NO real values. Copy the names into
# `.env.local` (on your computer) and into the Vercel dashboard (for the live site).

# Connection string for the Neon Postgres database (from the Neon console "Connect" button).
DATABASE_URL=

# How chatty the logs are: debug, info, warn, or error.
# Use "debug" in .env.local (your computer) and "info" in the Vercel dashboard (the live site).
LOG_LEVEL=

# OpenAI API key, used to turn text into embeddings (search by meaning). Keep it secret.
OPENAI_API_KEY=

# A secret you make up (try `openssl rand -hex 24`). The /search page and its API need it
# until real login exists. Keep it secret.
ADMIN_API_KEY=

# A second secret you make up (try `openssl rand -hex 24`), different from ADMIN_API_KEY.
# It unlocks the live MCP server at /api/mcp (one read-only tool). Sent as
# "Authorization: Bearer <key>". Keep it secret.
MCP_API_KEY=

# Not secret. The live MCP server the triage agent reads (npm run agent:triage), for example
# https://<your-app>.vercel.app/api/mcp
MCP_SERVER_URL=

# Signs the login cookie (jose). Make one with `openssl rand -hex 32`. Use a DIFFERENT value
# in Vercel than on your computer. At least 32 characters. Keep it secret.
SESSION_SECRET=

# The shared password for every demo login (npm run demo:seed / demo:reset). At least 8
# characters. Keep it private; anyone with it can open the demo accounts while demo mode is on.
DEMO_PASSWORD=

# Claude API key, used to write answers from the retrieved passages. Keep it secret.
ANTHROPIC_API_KEY=

# Optional. The Claude model that writes answers. Leave empty to use the default (claude-sonnet-5-5).
ANSWER_MODEL=

# Optional. Only needed if your Claude API key is not tied to one workspace (the API then
# answers status 400). The ID starts with wrkspc_ and is in the Claude Console under Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Optional. The most questions the public /ask page answers per hour, for the whole site
# (counted from the log table). Leave empty to use the default (60).
ASK_HOURLY_CAP=

# Super Admin stack links (/admin): each opens that service's dashboard. Not secrets; optional.
# Use full https:// addresses. Any left empty are simply not shown.
STACK_URL_DATABASE=
STACK_URL_HOSTING=
STACK_URL_DEPLOYMENTS=
STACK_URL_REPO=
STACK_URL_STORAGE=
STACK_URL_EMBEDDINGS=

# The real Super Admin account (you). Used once by npm run admin:create (development) and by
# POST /api/admin/super-admin (the live site, with the admin key). The password is at least 12
# characters. You can delete SUPER_ADMIN_PASSWORD after the account is made.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
